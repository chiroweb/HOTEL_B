---
import '../styles/nav.css';

interface NavSection {
  readonly id: string;
  readonly label: string;
}

const sections: readonly NavSection[] = [
  { id: 'coast', label: 'Coast' },
  { id: 'landmark', label: 'Landmark' },
  { id: 'day', label: 'Day' },
  { id: 'window', label: 'Window' },
  { id: 'space', label: 'Space' },
  { id: 'address', label: 'Address' },
];
---

<a class="skip-link label-mono" href="#main">Skip to content</a>

<nav class="nav" aria-label="Primary">
  <a class="nav__brand" href="#coast">
    <span class="nav__brand-mark">WYNDHAM</span>
    <span class="nav__brand-meta label-mono-sm" aria-hidden="true">
      BUSAN / COASTAL LANDMARK
    </span>
  </a>

  <ul class="nav__sections" id="nav-sections">
    {
      sections.map((section, i) => (
        <li>
          <a
            class="nav__link label-mono"
            href={`#${section.id}`}
            data-section={section.id}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <span class="numeral">{String(i + 1).padStart(2, '0')}</span>
            <span aria-hidden="true">&nbsp;/&nbsp;</span>
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>

  <a
    class="nav__contact label-mono"
    href="mailto:contact@example.com"
    aria-label="Open email to contact the hotel"
  >
    Contact &rarr;
  </a>
</nav>

<script>
  // Scroll-direction auto-hide. Hides on scroll-down, reveals on scroll-up
  // and whenever the user is within TOP_BAND of the page top.
  const nav = document.querySelector<HTMLElement>('.nav');
  if (nav) {
    const TOP_BAND = 80;
    const TICK = 4; // jitter threshold
    let lastY = window.scrollY;
    let pending = false;

    const apply = () => {
      pending = false;
      const y = window.scrollY;
      const dy = y - lastY;

      if (y < TOP_BAND) {
        nav.dataset.state = '';
      } else if (Math.abs(dy) > TICK) {
        nav.dataset.state = dy > 0 ? 'hidden' : '';
      }
      lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(apply);
      },
      { passive: true }
    );
  }
</script>
