---
/**
 * Annotation — architectural label with 1px brass hairline pointer.
 *
 * Renders right-anchored within an absolute-positioned overlay (the
 * parent should be position: relative + the overlay container).
 * Initial state is hidden (data-state="hidden"); a motion module flips
 * to data-state="visible" at the desired progress threshold.
 *
 * Brass scope (R4): the hairline span is the ONLY brass element here.
 * Label uses ink (inherits from section). The hairline is informational
 * — it points to a feature region of the image, not decorative.
 */

interface Props {
  /** Mono label text. */
  label: string;
  /** Vertical position in % from top of the parent overlay (0–100). */
  y: number;
  /** Horizontal extent of the brass pointer hairline. */
  pointerLength?: string;
}

const { label, y, pointerLength = '8vw' } = Astro.props;
---

<div
  class="annotation"
  data-annotation
  data-state="hidden"
  style={`--annotation-y: ${y}%; --annotation-pointer: ${pointerLength};`}
>
  <span class="annotation__hairline" data-hairline aria-hidden="true"></span>
  <span class="annotation__label label-mono">{label}</span>
</div>

<style>
  .annotation {
    position: absolute;
    top: var(--annotation-y);
    right: 0;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    /* Anchor inside the frame so the label rides on the photo with a
       legibility shadow. Avoids viewport-overflow risk on narrow widths. */
    padding-right: clamp(0.5rem, 1.5vw, 1rem);
    max-width: 100%;
  }

  .annotation__hairline {
    display: block;
    width: var(--annotation-pointer);
    height: var(--hairline);
    background: var(--color-brass);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--duration-state-cross) var(--ease-editorial);
  }

  .annotation__label {
    color: var(--color-ivory);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--duration-state-cross) var(--ease-editorial),
      transform var(--duration-state-cross) var(--ease-editorial);
    transition-delay: 60ms; /* hairline draws first by ≈60ms */
  }

  .annotation[data-state='visible'] .annotation__hairline {
    transform: scaleX(1);
  }

  .annotation[data-state='visible'] .annotation__label {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .annotation {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .annotation .annotation__hairline {
      transform: scaleX(1);
      transition: none;
    }
    .annotation .annotation__label {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
