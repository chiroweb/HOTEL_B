---
import '../styles/sections.css';

import Editorial from '../layouts/Editorial.astro';
import Coast from '../components/sections/Coast.astro';
import Landmark from '../components/sections/Landmark.astro';
import Day from '../components/sections/Day.astro';
import Window from '../components/sections/Window.astro';
import Space from '../components/sections/Space.astro';
import Address from '../components/sections/Address.astro';
---

<Editorial>
  <Coast />
  <Landmark />
  <Day />
  <Window />
  <Space />
  <Address />
</Editorial>

<script>
  // Phase 1 baseline: until each section ships its real editorial layout
  // (Unit 6 → Coast; Phase 2 → Landmark/Day/Window/Space/Address), they all
  // render in stub mode (centered heading, no body content).
  for (const id of ['coast', 'landmark', 'day', 'window', 'space', 'address']) {
    document.getElementById(id)?.classList.add('is-stub');
  }
</script>
