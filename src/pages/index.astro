---
import Editorial from '../layouts/Editorial.astro';
---

<Editorial>
  <section id="coast" style="min-height: 100svh; display: grid; place-items: center;">
    <p class="label-mono">( 01 / THE COAST )</p>
  </section>
  <section id="landmark" style="min-height: 100svh; display: grid; place-items: center;">
    <p class="label-mono">( 02 / VERTICAL )</p>
  </section>
  <section id="day" style="min-height: 100svh; display: grid; place-items: center;">
    <p class="label-mono">( 03 / FLOW )</p>
  </section>
  <section id="window" style="min-height: 100svh; display: grid; place-items: center;">
    <p class="label-mono">( 04 / THE WINDOW )</p>
  </section>
  <section id="space" style="min-height: 100svh; display: grid; place-items: center;">
    <p class="label-mono">( 05 / THE SPACE )</p>
  </section>
  <section id="address" style="min-height: 100svh; display: grid; place-items: center;">
    <p class="label-mono">( 06 / ADDRESS )</p>
  </section>
</Editorial>
