---
import SectionWrapper from '../SectionWrapper.astro';
import { getImage } from '../../lib/asset';
import '../../styles/prologue.css';

const poster = getImage('PROLOGUE-01');
---

<SectionWrapper id="coast" index="01" title="COAST">
  <span slot="display" class="display-lg coast__display" data-reveal="display">
    Wyndham Songjeong
  </span>
  <span slot="display-ko" class="display-ko-md coast__display-ko" lang="ko" data-reveal="ko">
    윈덤 송정 &middot; 부산의 새로운 해안 랜드마크.
  </span>

  <div class="coast__stage">
    <p class="coast__side coast__side--left" data-reveal="side-left">
      <span>When light arrives,</span>
      <span>the coast becomes a</span>
      <span>quieter kind of room.</span>
    </p>

    <div class="coast__frame" data-hero-layer>
      <img
        class="coast__poster"
        src={poster.url}
        alt={poster.alt}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
      <div data-video-mount aria-hidden="true"></div>
    </div>

    <p class="coast__side coast__side--right" data-reveal="side-right">
      <span>35&deg; 10&prime; 41&Prime; N</span>
      <span>129&deg; 12&prime; 02&Prime; E</span>
      <span class="coast__side-mute">SONGJEONG BEACH</span>
      <span class="coast__side-mute">BUSAN, KOREA</span>
    </p>
  </div>

  <div class="coast__rail">
    <span class="coast__rail-item coast__rail-item--left">EST. 2026</span>
    <span class="coast__rail-item coast__rail-item--center">
      A NEW HORIZON ON THE COAST OF BUSAN.
    </span>
    <span class="coast__rail-item coast__rail-item--right numeral">
      01 &mdash; 06
    </span>
  </div>
</SectionWrapper>

<!-- Motion is wired centrally by engine.ts via section-chain.ts. -->
