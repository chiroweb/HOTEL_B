---
import { Picture } from 'astro:assets';

import SectionWrapper from '../SectionWrapper.astro';
import Annotation from '../Annotation.astro';
import { getImage } from '../../lib/asset';
import '../../styles/landmark.css';

const facade = getImage('LANDMARK-02');

interface AnnotationSpec {
  label: string;
  y: number; // % from top of overlay container
}

// Tied to LANDMARK-02's feature regions: glass curtain wall (upper),
// vertical fin pattern (middle), sunset reflection (lower).
const annotations: AnnotationSpec[] = [
  { label: 'Facade', y: 22 },
  { label: 'Rhythm', y: 55 },
  { label: 'Light', y: 82 },
];
---

<SectionWrapper id="landmark" index="02" title="VERTICAL">
  <span slot="display" class="display-lg" data-reveal="display">
    A Vertical Mark<br />on the Shore
  </span>
  <span slot="display-ko" class="display-ko-md" lang="ko" data-reveal="ko">
    송정의 수평선 위에 세워지는 수직의 기준.
  </span>

  <div class="landmark__frame" data-frame>
    <Picture
      src={facade.import}
      alt={facade.alt}
      widths={[480, 720, 1200]}
      sizes="(max-width: 768px) 90vw, 70vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'landmark__picture' }}
    />
    <div class="landmark__overlay" data-overlay aria-hidden="true">
      {annotations.map((a) => <Annotation label={a.label} y={a.y} />)}
    </div>
  </div>
</SectionWrapper>

<script>
  import { register } from '../../lib/motion/registry';
  import { currentMode } from '../../lib/motion/breakpoint';

  const el = document.getElementById('landmark');
  if (el) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.disconnect();
          void import('../../lib/motion/landmark').then(({ landmarkModule }) => {
            register(landmarkModule, el as HTMLElement, currentMode());
          });
        }
      },
      { rootMargin: '50%' }
    );
    io.observe(el);
  }
</script>
