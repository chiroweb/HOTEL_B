---
import '../styles/global.css';

import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'WYNDHAM — Songjeong Coastal Landmark',
  description = 'Songjeong Landmark (WYNDHAM): a coastal editorial site for Busan. Six scroll-driven sections, no booking funnel — desire over advertising.',
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://wyndham.example/').toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://wyndham.example/').toString();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Open Graph + Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Critical-path: Latin display Regular weight preloaded for LCP-adjacent
        text. Pretendard subset KR loads via swap (Korean copy is below the
        fold of first paint). */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-tight-latin-regular.woff2"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <h1 class="visually-hidden">WYNDHAM &mdash; Songjeong Coastal Landmark</h1>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <script>
      import { boot } from '../lib/motion/engine';
      boot();
    </script>
  </body>
</html>
