---
import '../styles/nav.css';

interface NavSection {
  readonly id: string;
  readonly label: string;
}

const sections: readonly NavSection[] = [
  { id: 'coast', label: 'Coast' },
  { id: 'landmark', label: 'Landmark' },
  { id: 'day', label: 'Day' },
  { id: 'window', label: 'Window' },
  { id: 'space', label: 'Space' },
  { id: 'address', label: 'Address' },
];
---

<a class="skip-link label-mono" href="#main">Skip to content</a>

<a class="nav-logo" href="#coast" aria-label="Back to coast — top of site">
  <span class="nav-logo__mark">WYNDHAM</span>
</a>

<button
  class="nav-toggle"
  type="button"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="nav-menu"
>
  <span class="nav-toggle__bar" aria-hidden="true"></span>
  <span class="nav-toggle__bar" aria-hidden="true"></span>
  <span class="nav-toggle__bar" aria-hidden="true"></span>
</button>

<aside
  class="nav-menu"
  id="nav-menu"
  aria-hidden="true"
  aria-label="Section menu"
>
  <ul class="nav-menu__list">
    {
      sections.map((section, i) => (
        <li class="nav-menu__item">
          <a
            class="nav__link nav-menu__link"
            href={`#${section.id}`}
            data-section={section.id}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <span class="numeral nav-menu__num">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="nav-menu__label">{section.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <a
    class="nav-menu__contact label-mono"
    href="mailto:contact@example.com"
    aria-label="Open email to contact the hotel"
  >
    Contact &rarr;
  </a>
</aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('.nav-menu');
  const links = document.querySelectorAll<HTMLAnchorElement>('.nav-menu__link');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.dataset.open = open ? 'true' : 'false';
      menu.dataset.open = open ? 'true' : 'false';
      menu.setAttribute('aria-hidden', String(!open));
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.dataset.open === 'true';
      setOpen(!isOpen);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.dataset.open === 'true') setOpen(false);
    });

    // Each link closes the menu and routes through the existing
    // section-dots:jump channel — scroll-hijack.ts already listens for
    // that event, so the stack transition runs even with hijack active.
    links.forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.dataset.section;
        if (id) {
          e.preventDefault();
          window.dispatchEvent(
            new CustomEvent('section-dots:jump', { detail: { id } })
          );
        }
        setOpen(false);
      });
    });
  }
</script>
