---
import SectionWrapper from '../SectionWrapper.astro';
import { getImage, getVideo } from '../../lib/asset';
import '../../styles/window.css';

const bgVideo = getVideo('WINDOW-BG');
const floatA = getImage('ROOM-DETAIL-3');
const floatB = getImage('ROOM-DETAIL-4');
const floatC = getImage('AMENITY-ROOMS');
---

<SectionWrapper id="window" index="04" title="THE WINDOW">
  <span slot="display" class="display-lg" data-reveal="display">
    The View<br />Is Not an Amenity
  </span>
  <span slot="display-ko" class="display-ko-md" lang="ko" data-reveal="ko">
    그것은 이 주소의 본질이다.
  </span>

  <div class="window__main">
    <video
      class="window__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    >
      {bgVideo.sources.map((src) => <source src={src.src} type={src.type} />)}
    </video>
  </div>

  <figure class="window__float window__float--a">
    <img src={floatA.url} alt={floatA.alt} loading="lazy" decoding="async" />
    <figcaption class="label-mono">Suite &middot; detail</figcaption>
  </figure>

  <figure class="window__float window__float--b">
    <img src={floatB.url} alt={floatB.alt} loading="lazy" decoding="async" />
    <figcaption class="label-mono">Quiet &middot; corners</figcaption>
  </figure>

  <figure class="window__float window__float--c">
    <img src={floatC.url} alt={floatC.alt} loading="lazy" decoding="async" />
    <figcaption class="label-mono">Room &middot; details</figcaption>
  </figure>
</SectionWrapper>

<!-- Motion is wired centrally by engine.ts via section-chain.ts. -->
