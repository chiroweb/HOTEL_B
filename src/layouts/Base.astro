---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'WYNDHAM — Songjeong Coastal Landmark', description = '' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
