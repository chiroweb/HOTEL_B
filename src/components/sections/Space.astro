---
import SectionWrapper from '../SectionWrapper.astro';
import { getImage } from '../../lib/asset';
import { SPACE_CATEGORIES } from '../../data/space-content';
import '../../styles/space.css';

/** Render display heading text — newline → <br /> for multi-line copy. */
const initial = SPACE_CATEGORIES[0];
const initialDisplayLines = initial.display.split('\n');
---

<SectionWrapper id="space" index="05" title="THE SPACE" pinned>
  <span slot="display" class="display-lg" data-reveal="display" data-space-display>
    {initialDisplayLines.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))}
  </span>
  <span slot="display-ko" class="display-ko-md" lang="ko" data-reveal="ko" data-space-display-ko>
    {initial.displayKo}
  </span>

  <div class="space__image">
    {
      SPACE_CATEGORIES.map((cat, i) => {
        const img = getImage(cat.imageId);
        return (
          <img
            class="space__cat-image"
            data-cat-image={cat.id}
            data-active={i === 0 ? 'true' : 'false'}
            src={img.url}
            alt={img.alt}
            loading="lazy"
            decoding="async"
          />
        );
      })
    }
  </div>

  <ul class="space__cats" aria-label="Sub-categories">
    {
      SPACE_CATEGORIES.map((cat, i) => (
        <li
          class="space__cat"
          data-cat={cat.id}
          data-active={i === 0 ? 'true' : 'false'}
          tabindex="0"
        >
          <div class="space__cat-row">
            <span class="space__cat-label">{cat.label}</span>
            <span class="label-mono-sm" lang="ko">&nbsp;{cat.labelKo}</span>
            <span class="space__cat-meta label-mono-sm numeral">
              {cat.count} &middot; {cat.area}
            </span>
          </div>
          {cat.note && <p class="space__cat-note">{cat.note}</p>}
        </li>
      ))
    }
  </ul>
</SectionWrapper>

<script>
  const el = document.getElementById('space');
  if (!el) {
    /* nothing to wire */
  } else {
    // Category hover → cross-fade the frame photo. Activates on
    // mouseenter (desktop) and focus (keyboard). One-active-at-a-time;
    // initial active is whichever item ships with data-active='true'.
    const cats = el.querySelectorAll<HTMLElement>('.space__cat');
    const images = el.querySelectorAll<HTMLElement>('[data-cat-image]');

    const activate = (id: string) => {
      cats.forEach((c) => {
        c.dataset.active = c.dataset.cat === id ? 'true' : 'false';
      });
      images.forEach((im) => {
        im.dataset.active = im.dataset.catImage === id ? 'true' : 'false';
      });
    };

    cats.forEach((c) => {
      const enter = () => {
        const id = c.dataset.cat;
        if (id) activate(id);
      };
      c.addEventListener('mouseenter', enter);
      c.addEventListener('focus', enter);
    });

    // Motion is wired centrally by engine.ts via section-chain.ts (post 2026-04-28-003).
  }
</script>
